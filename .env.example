# Neon (Vercel Postgres / Neon integration)
# Use as variáveis do dashboard. Não precisa de todas as POSTGRES_* / PG*.

# Obrigatória — connection pooled (pgbouncer). App / Serverless.
DATABASE_URL=

# Recomendada — sem pgbouncer. Migrations (drizzle-kit push/migrate).
DATABASE_URL_UNPOOLED=

# NextAuth (Auth.js v5)
AUTH_SECRET=
# Opcional em local; em produção a Vercel define o host
# AUTH_URL=http://localhost:3000

NEXT_PUBLIC_APP_URL=http://localhost:3000

# E-mail (recuperação de senha)
RESEND_API_KEY=
EMAIL_FROM=nao-responda@fisiogeovane.com.br

# Google OAuth (Calendar + Drive — não é login do sistema)
# Console: https://console.cloud.google.com/apis/credentials
# Ative também a Google Drive API no mesmo projeto.
# Redirect URIs:
#   {NEXT_PUBLIC_APP_URL}/api/admin/integrations/google-calendar/callback
#   {NEXT_PUBLIC_APP_URL}/api/admin/integrations/google-drive/callback
# Escopos Calendar: calendar.events + calendar.calendarlist.readonly + openid email profile
# Escopos Drive: drive.file + openid email profile
# Após mudar escopos, reconecte a conta em Configurações → Integrações.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Opcional — sobrescreve o redirect derivado de NEXT_PUBLIC_APP_URL
# GOOGLE_REDIRECT_URI=http://localhost:3000/api/admin/integrations/google-calendar/callback
# GOOGLE_DRIVE_REDIRECT_URI=http://localhost:3000/api/admin/integrations/google-drive/callback

# Cron de backup no Drive (Vercel Cron envia Authorization: Bearer CRON_SECRET)
CRON_SECRET=

# --- Variáveis que a integração Vercel/Neon também injeta (opcional) ---
# PGHOST, PGHOST_UNPOOLED, PGUSER, PGDATABASE, PGPASSWORD
# POSTGRES_URL, POSTGRES_URL_NON_POOLING, POSTGRES_USER, POSTGRES_HOST,
# POSTGRES_PASSWORD, POSTGRES_DATABASE, POSTGRES_URL_NO_SSL, POSTGRES_PRISMA_URL
# Não usamos no código: DATABASE_URL cobre o app; UNPOOLED cobre migrations.
